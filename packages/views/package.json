{
  "name": "@duyo/views",
  "version": "1.0.0",
  "description": "Duyo views: the design as a JSON spec, the behaviour as a code-behind. Spec validation, generated types, a CLI and a Vite plugin.",
  "license": "Apache-2.0",
  "author": "achunt2143",
  "homepage": "https://github.com/achunt2143/duyo/tree/main/packages/views#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/achunt2143/duyo.git",
    "directory": "packages/views"
  },
  "bugs": {
    "url": "https://github.com/achunt2143/duyo/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./spec": {
      "types": "./src/browser.d.ts",
      "default": "./src/browser.js"
    },
    "./load": {
      "types": "./src/load.d.ts",
      "default": "./src/load.js"
    },
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    }
  },
  "bin": {
    "duyo-views": "./bin/duyo-views.js"
  },
  "files": [
    "src/",
    "bin/",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
