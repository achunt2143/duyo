{
  "name": "duyo",
  "version": "1.1.0",
  "description": "Duyo: an EnyoJS-style framework for React. Kinds, components and events as data, with Remochi and Onyx as first-party packs, and views you can design.",
  "license": "Apache-2.0",
  "author": "achunt2143",
  "homepage": "https://github.com/achunt2143/duyo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/achunt2143/duyo.git",
    "directory": "packages/duyo"
  },
  "bugs": {
    "url": "https://github.com/achunt2143/duyo/issues"
  },
  "keywords": [
    "duyo",
    "enyo",
    "webos",
    "react",
    "kinds",
    "components",
    "remochi",
    "onyx"
  ],
  "type": "module",
  "exports": {
    ".": "./lib/core/src/index.ts",
    "./layout": "./lib/layout/src/index.ts",
    "./react": "./lib/react/src/index.ts",
    "./views": {
      "types": "./lib/views/src/index.d.ts",
      "default": "./lib/views/src/index.js"
    },
    "./views/spec": {
      "types": "./lib/views/src/browser.d.ts",
      "default": "./lib/views/src/browser.js"
    },
    "./views/load": {
      "types": "./lib/views/src/load.d.ts",
      "default": "./lib/views/src/load.js"
    },
    "./views/vite": {
      "types": "./lib/views/src/vite.d.ts",
      "default": "./lib/views/src/vite.js"
    },
    "./remochi": "./lib/remochi/src/index.tsx",
    "./remochi/css": "./lib/remochi/src/css.ts",
    "./onyx": "./lib/onyx/src/index.tsx",
    "./onyx/css": "./lib/onyx/src/css.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "scripts": {
    "assemble": "node scripts/assemble.mjs",
    "prepack": "node scripts/assemble.mjs",
    "sync": "node scripts/assemble.mjs --sync",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "remochi": "^0.4.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "remochi": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "duyo": {
    "includes": [
      "core",
      "layout",
      "react",
      "views",
      "remochi",
      "onyx"
    ]
  },
  "bin": {
    "duyo-views": "lib/views/bin/duyo-views.js"
  }
}
