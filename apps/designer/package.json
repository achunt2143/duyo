{
  "name": "duyo-designer",
  "version": "0.1.0",
  "private": true,
  "description": "A visual designer for Duyo views: edits .view.json files with a live preview, as Ares did for Enyo.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "views": "duyo-views src",
    "typecheck": "duyo-views src --check && tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@duyo/core": "*",
    "@duyo/react": "*",
    "@duyo/remochi": "*",
    "@duyo/views": "*",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  }
}
