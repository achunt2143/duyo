{
  "name": "Designer.App",
  "kind": "remochi.ThemeWrapper",
  "theme": "dark",
  "syncHtml": true,
  "style": "height: 100%;",
  "components": [
    {
      "kind": "duyo.FittableRows",
      "fill": true,
      "components": [
        {
          "kind": "duyo.FittableColumns",
          "align": "center",
          "gap": "sm",
          "padding": "sm",
          "style": "border-bottom: 1px solid rgba(127,127,127,0.3); flex-wrap: wrap;",
          "components": [
            { "kind": "remochi.Header", "content": "Duyo Designer", "style": "margin-right: 12px;" },
            { "kind": "remochi.Button", "name": "saveButton", "content": "Save", "variant": "affirmative", "ontap": "save" },
            { "kind": "remochi.Button", "name": "saveAllButton", "content": "Save all", "ontap": "saveAll" },
            { "kind": "remochi.Button", "name": "undoButton", "content": "Undo", "ontap": "undo" },
            { "kind": "remochi.Button", "name": "redoButton", "content": "Redo", "ontap": "redo" },
            { "kind": "remochi.Button", "name": "cutButton", "content": "Cut", "ontap": "cut" },
            { "kind": "remochi.Button", "name": "copyButton", "content": "Copy", "ontap": "copy" },
            { "kind": "remochi.Button", "name": "pasteButton", "content": "Paste", "ontap": "paste" },
            {
              "tag": "span",
              "name": "status",
              "fit": true,
              "style": "opacity: 0.8; text-align: right; font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
            },
            { "kind": "remochi.Button", "content": "Help", "ontap": "help" }
          ]
        },
        {
          "kind": "duyo.FittableColumns",
          "fit": true,
          "style": "min-height: 0;",
          "components": [
            {
              "kind": "duyo.FittableRows",
              "gap": "sm",
              "padding": "sm",
              "style": "width: 250px; flex: none; min-height: 0; overflow: hidden; border-right: 1px solid rgba(127,127,127,0.3);",
              "components": [
                {
                  "kind": "remochi.ViewSelectButton",
                  "name": "leftTabs",
                  "items": [{ "content": "Files", "value": "files" }, { "content": "Palette", "value": "palette" }],
                  "onSelect": "leftTabChanged"
                },
                {
                  "kind": "Designer.Files",
                  "name": "files",
                  "fit": true,
                  "style": "min-height: 0;",
                  "onOpen": "fileOpened",
                  "onNewView": "newView",
                  "onNewFolder": "newFolder",
                  "onRename": "renameFile",
                  "onDelete": "deleteFile"
                },
                { "kind": "Designer.Palette", "name": "palette", "fit": true, "showing": false, "style": "min-height: 0;", "onAdd": "paletteAdd" }
              ]
            },
            {
              "kind": "duyo.FittableRows",
              "fit": true,
              "style": "min-width: 0; min-height: 0;",
              "components": [
                {
                  "kind": "Designer.Tabs",
                  "name": "tabs",
                  "style": "border-bottom: 1px solid rgba(127,127,127,0.3);",
                  "onActivate": "tabActivated",
                  "onClose": "tabClosed"
                },
                {
                  "kind": "duyo.FittableColumns",
                  "align": "center",
                  "gap": "sm",
                  "padding": "sm",
                  "components": [
                    {
                      "kind": "remochi.ViewSelectButton",
                      "name": "modes",
                      "items": [
                        { "content": "Design", "value": "design" },
                        { "content": "Code", "value": "code" },
                        { "content": "JSON", "value": "json" },
                        { "content": "Run", "value": "run" }
                      ],
                      "onSelect": "modeChanged"
                    },
                    { "fit": true },
                    { "kind": "remochi.Dropdown", "name": "device", "maxHeight": 320, "onChange": "deviceChanged" },
                    { "kind": "remochi.Button", "name": "rotateButton", "content": "Rotate", "ontap": "rotate" },
                    { "kind": "remochi.Dropdown", "name": "zoom", "maxHeight": 320, "onChange": "zoomChanged" },
                    { "kind": "remochi.Button", "name": "reloadButton", "content": "Reload", "showing": false, "ontap": "reloadRun" },
                    { "kind": "remochi.Button", "name": "windowButton", "content": "Open in window", "showing": false, "ontap": "openRunWindow" }
                  ]
                },
                { "kind": "Designer.Canvas", "name": "canvas", "fit": true, "onPick": "picked", "onDropAt": "canvasDrop" },
                { "kind": "Designer.Code", "name": "code", "fit": true, "showing": false, "onEdit": "codeEdited" },
                { "kind": "Designer.Code", "name": "json", "language": "json", "fit": true, "showing": false, "onEdit": "jsonEdited" },
                { "kind": "Designer.Run", "name": "run", "fit": true, "showing": false }
              ]
            },
            {
              "kind": "duyo.FittableRows",
              "gap": "sm",
              "padding": "sm",
              "style": "width: 380px; flex: none; min-height: 0; overflow: hidden; border-left: 1px solid rgba(127,127,127,0.3);",
              "components": [
                { "kind": "remochi.Subheader", "content": "Components" },
                {
                  "kind": "Designer.Tree",
                  "name": "tree",
                  "style": "max-height: 36%; overflow-y: auto; flex: none;",
                  "onSelect": "treeSelected",
                  "onMove": "treeMoved",
                  "onDropKind": "treeDroppedKind"
                },
                {
                  "kind": "duyo.FittableColumns",
                  "gap": "sm",
                  "style": "flex-wrap: wrap;",
                  "components": [
                    { "kind": "remochi.Button", "content": "Up", "ontap": "moveUp" },
                    { "kind": "remochi.Button", "content": "Down", "ontap": "moveDown" },
                    { "kind": "remochi.Button", "content": "In", "ontap": "indent" },
                    { "kind": "remochi.Button", "content": "Out", "ontap": "outdent" },
                    { "kind": "remochi.Button", "content": "Duplicate", "ontap": "duplicate" },
                    { "kind": "remochi.Button", "content": "Delete", "variant": "warning", "ontap": "remove" }
                  ]
                },
                {
                  "kind": "remochi.ViewSelectButton",
                  "name": "inspectorTabs",
                  "items": [
                    { "content": "Properties", "value": "properties" },
                    { "content": "Layout", "value": "layout" },
                    { "content": "Events", "value": "events" },
                    { "content": "View", "value": "view" }
                  ],
                  "onSelect": "inspectorTabChanged"
                },
                { "name": "inspector", "fit": true, "style": "overflow-y: auto; overflow-x: hidden; min-height: 0;" }
              ]
            }
          ]
        },
        {
          "tag": "footer",
          "name": "problems",
          "style": "font: 12px/1.5 ui-monospace, monospace; padding: 6px 16px; min-height: 3em; max-height: 8em; overflow-y: auto; white-space: pre-wrap; border-top: 1px solid rgba(127,127,127,0.3);"
        }
      ]
    }
  ]
}
