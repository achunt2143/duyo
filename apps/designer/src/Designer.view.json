{
  "name": "Designer.App",
  "kind": "remochi.ThemeWrapper",
  "theme": "dark",
  "syncHtml": true,
  "style": "height: 100%;",
  "components": [
    {
      "kind": "duyo.FittableRows",
      "fill": true,
      "components": [
        {
          "kind": "duyo.FittableColumns",
          "align": "center",
          "gap": "sm",
          "padding": "sm",
          "components": [
            {
              "tag": "span",
              "content": "Duyo Designer",
              "style": "font-size: 20px; font-weight: 300; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 16px 0 8px; white-space: nowrap;"
            },
            {
              "kind": "remochi.Button",
              "name": "projectButton",
              "content": "Project",
              "variant": "dropdown",
              "ontap": "projectMenu"
            },
            {
              "kind": "remochi.PopupPanel",
              "name": "projectMenuPanel",
              "anchor": "projectButton",
              "title": "Project",
              "onAction": "projectAction",
              "onClose": "projectMenuClosed"
            },
            {
              "tag": "span",
              "name": "status",
              "fit": true,
              "style": "opacity: 0.75; font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0;"
            },
            { "kind": "remochi.Button", "name": "undoButton", "content": "Undo", "ontap": "undo" },
            { "kind": "remochi.Button", "name": "redoButton", "content": "Redo", "ontap": "redo" },
            { "kind": "remochi.Button", "name": "saveAllButton", "content": "Save all", "ontap": "saveAll" },
            { "kind": "remochi.Button", "name": "saveButton", "content": "Save", "variant": "affirmative", "ontap": "save" },
            { "kind": "remochi.Button", "content": "Help", "variant": "blue", "ontap": "help" }
          ]
        },
        { "kind": "remochi.Divider" },
        {
          "kind": "duyo.FittableColumns",
          "fit": true,
          "style": "min-height: 0;",
          "components": [
            {
              "kind": "duyo.FittableRows",
              "name": "explorer",
              "gap": "sm",
              "padding": "sm",
              "style": "width: 270px; flex: none; min-height: 0; background: var(--mochi-surface);",
              "components": [
                {
                  "kind": "remochi.ViewSelectButton",
                  "name": "leftTabs",
                  "items": [
                    { "content": "Files", "value": "files" },
                    { "content": "Palette", "value": "palette" },
                    { "content": "Changes", "value": "changes" }
                  ],
                  "onSelect": "leftTabChanged"
                },
                {
                  "kind": "duyo.FittableRows",
                  "name": "browse",
                  "style": "height: 40%; flex: none; min-height: 0;",
                  "components": [
                    {
                      "kind": "Designer.Files",
                      "name": "files",
                      "fit": true,
                      "onOpen": "fileOpened",
                      "onNewView": "newView",
                      "onNewFolder": "newFolder",
                      "onRename": "renameFile",
                      "onDelete": "deleteFile"
                    },
                    { "kind": "Designer.Palette", "name": "palette", "fit": true, "showing": false, "onAdd": "paletteAdd" },
                    {
                      "kind": "duyo.FittableRows",
                      "name": "changesPane",
                      "fit": true,
                      "showing": false,
                      "gap": "sm",
                      "style": "min-height: 0;",
                      "components": [
                        {
                          "kind": "Designer.Changes",
                          "name": "changes",
                          "fit": true,
                          "onOpen": "fileOpened",
                          "onAction": "gitAction"
                        },
                        {
                          "kind": "remochi.Input",
                          "name": "commitMessage",
                          "placeholder": "Describe the change",
                          "width": "100%"
                        },
                        {
                          "kind": "duyo.FittableColumns",
                          "gap": "sm",
                          "components": [
                            {
                              "kind": "remochi.Button",
                              "name": "commitButton",
                              "content": "Commit",
                              "variant": "affirmative",
                              "ontap": "commitChanges"
                            },
                            {
                              "kind": "remochi.Button",
                              "name": "pushButton",
                              "content": "Push",
                              "variant": "blue",
                              "ontap": "pushChanges"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "kind": "Designer.Splitter",
                  "name": "browseSplit",
                  "orientation": "horizontal",
                  "onResize": "browseResized",
                  "components": [
                    { "kind": "remochi.NubbinDivider", "nubbin": "down", "style": "width: 100%;" }
                  ]
                },
                { "kind": "remochi.Subheader", "content": "Components" },
                {
                  "kind": "Designer.Tree",
                  "name": "tree",
                  "fit": true,
                  "onSelect": "treeSelected",
                  "onMove": "treeMoved",
                  "onDropKind": "treeDroppedKind",
                  "onAction": "treeAction"
                }
              ]
            },
            {
              "kind": "Designer.Splitter",
              "name": "explorerSplit",
              "onResize": "explorerResized",
              "components": [
                { "kind": "remochi.Divider", "orientation": "vertical", "style": "height: 100%;" }
              ]
            },
            {
              "kind": "duyo.FittableRows",
              "name": "workspace",
              "fit": true,
              "style": "min-width: 0; min-height: 0;",
              "components": [
                {
                  "kind": "Designer.Tabs",
                  "name": "tabs",
                  "style": "padding: 4px 8px 0;",
                  "onActivate": "tabActivated",
                  "onClose": "tabClosed"
                },
                {
                  "kind": "duyo.FittableColumns",
                  "align": "center",
                  "gap": "sm",
                  "padding": "sm",
                  "components": [
                    {
                      "kind": "remochi.ViewSelectButton",
                      "name": "modes",
                      "items": [
                        { "content": "Design", "value": "design" },
                        { "content": "Code", "value": "code" },
                        { "content": "JSON", "value": "json" },
                        { "content": "Run", "value": "run" }
                      ],
                      "onSelect": "modeChanged"
                    },
                    { "fit": true },
                    { "kind": "remochi.Dropdown", "name": "device", "maxHeight": 320, "onChange": "deviceChanged" },
                    { "kind": "remochi.Button", "name": "rotateButton", "content": "Rotate", "ontap": "rotate" },
                    { "kind": "remochi.Dropdown", "name": "zoom", "maxHeight": 320, "onChange": "zoomChanged" },
                    {
                      "kind": "remochi.Button",
                      "name": "reloadButton",
                      "content": "Reload",
                      "showing": false,
                      "ontap": "reloadRun"
                    },
                    {
                      "kind": "remochi.Button",
                      "name": "windowButton",
                      "content": "Pop out",
                      "showing": false,
                      "ontap": "openRunWindow"
                    }
                  ],
                  "style": "flex-wrap: wrap; row-gap: 4px;"
                },
                { "kind": "remochi.Divider", "thickness": 2 },
                { "kind": "Designer.Canvas", "name": "canvas", "fit": true, "onPick": "picked", "onDropAt": "canvasDrop" },
                { "kind": "Designer.Code", "name": "code", "fit": true, "showing": false, "onEdit": "codeEdited" },
                {
                  "kind": "Designer.Code",
                  "name": "json",
                  "language": "json",
                  "fit": true,
                  "showing": false,
                  "onEdit": "jsonEdited"
                },
                { "kind": "Designer.Run", "name": "run", "fit": true, "showing": false }
              ]
            },
            {
              "kind": "Designer.Splitter",
              "name": "inspectorSplit",
              "onResize": "inspectorResized",
              "components": [
                { "kind": "remochi.Divider", "orientation": "vertical", "style": "height: 100%;" }
              ]
            },
            {
              "kind": "duyo.FittableRows",
              "name": "inspectorColumn",
              "gap": "sm",
              "padding": "md",
              "style": "width: 380px; flex: none; min-height: 0; background: var(--mochi-surface);",
              "components": [
                {
                  "kind": "remochi.ViewSelectButton",
                  "name": "inspectorTabs",
                  "items": [
                    { "content": "Properties", "value": "properties" },
                    { "content": "Layout", "value": "layout" },
                    { "content": "Events", "value": "events" },
                    { "content": "View", "value": "view" }
                  ],
                  "onSelect": "inspectorTabChanged"
                },
                { "kind": "remochi.Divider", "thickness": 2 },
                {
                  "name": "inspector",
                  "fit": true,
                  "style": "overflow-y: auto; overflow-x: hidden; min-height: 0; padding-right: 4px;"
                }
              ]
            }
          ]
        },
        { "kind": "remochi.Divider", "name": "problemsDivider", "showing": false },
        {
          "tag": "footer",
          "name": "problems",
          "showing": false,
          "style": "font: 12px/1.5 ui-monospace, monospace; padding: 4px 16px 6px; max-height: 8em; overflow-y: auto; white-space: pre-wrap;"
        },
        {
          "kind": "remochi.Dialog",
          "name": "dialog",
          "size": "small",
          "onConfirm": "dialogConfirmed",
          "onCancel": "dialogCancelled",
          "onClose": "dialogClosed",
          "onAction": "dialogAction",
          "components": [
            { "tag": "p", "name": "dialogMessage", "style": "margin: 0 0 8px; white-space: pre-wrap;" },
            {
              "kind": "Designer.Picker",
              "name": "picker",
              "showing": false,
              "onChoose": "pickerChose",
              "onGo": "pickerWent",
              "onDouble": "pickerDoubled"
            }
          ]
        }
      ]
    }
  ]
}
